# ------------------------------------------------------------------
# NewCron Global Dispatch - configuracion
# Copia este archivo a .env y completa los valores de Solace Cloud.
# ------------------------------------------------------------------

# Puerto del servidor web (portal de clientes + dashboard transportistas)
PORT=3000

# Zona horaria usada para las validaciones de fecha/hora
# (operaciones en Estados Unidos, pickup en Milford, MA)
BUSINESS_TIMEZONE=America/New_York

# Hora limite para solicitudes con pickup el mismo dia (3:00 p.m.)
SAME_DAY_CUTOFF_HOUR=15

# ------------------------------------------------------------------
# Broker Solace (Solace Cloud free trial)
# Conecta desde la consola de Solace Cloud -> Connect tab:
#   - Secured Web Messaging URI  -> SOLACE_WSS_URL
#   - Message VPN                -> SOLACE_VPN
#   - Client Username/Password   -> SOLACE_USER / SOLACE_PASSWORD
#   - SEMP - REST API pane       -> SOLACE_SEMP_URL / SEMP user / pass
# ------------------------------------------------------------------
SOLACE_WSS_URL=
SOLACE_VPN=
SOLACE_USER=
SOLACE_PASSWORD=
SOLACE_SEMP_URL=
SOLACE_SEMP_USER=
SOLACE_SEMP_PASSWORD=

# "real"  -> usa el broker Solace Cloud (requiere credenciales)
# "mock"  -> broker simulado en memoria (desarrollo sin credenciales)
BROKER_MODE=mock
